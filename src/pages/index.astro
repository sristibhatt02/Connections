---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { profile, experience, education, skillGroups } from '../data/profile';
import { research } from '../data/research';
const base = import.meta.env.BASE_URL;
---
<Layout>
  <div class="wrap">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="eyebrow">BIOINFORMATICS · RESEARCH · DATA ANALYSIS</p>
        <h1 id="intro-title">Sristi Bhattacharjee</h1>
        <p class="intro-role">A research background. <br />An analytical approach to work.</p>
        <p class="intro-description">I work with data, sequencing workflows and scientific information. My background spans bioinformatics and marine science, with a focus on careful analysis, clear documentation and communicating results.</p>
        <div class="intro-actions"><a class="button" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Get in touch <span aria-hidden="true">↗</span></a><a class="text-link" href="#experience">View my experience <span aria-hidden="true">↓</span></a></div>
      </div>
      <figure class="portrait"><div class="portrait-setting"><div class="portrait-frame"><Image src={profile.portrait} alt="Sristi Bhattacharjee wearing a navy blazer in a glass atrium" widths={[320, 480, 640]} sizes="(max-width: 600px) 190px, 280px" width={640} height={640} format="webp" quality={85} loading="eager" fetchpriority="high" /></div><span class="portrait-accent" aria-hidden="true"></span></div><figcaption><span class="location-dot" aria-hidden="true"></span> {profile.location}</figcaption></figure>
    </section>
    <section class="content-section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="section-title"><h2 id="experience-title">Experience</h2><span>Research & internships</span></div>
      <div class="experience-list">{experience.map(item => <article class="experience-entry"><div class="entry-date"><span>{item.dates}</span><span class="entry-type">{item.type}</span></div><div class="entry-content"><h3>{item.role}</h3><p class="organisation">{item.organisation}</p><p class="entry-description">{item.text}</p><ul class="tag-list" aria-label="Skills used">{item.skills.split(' · ').map(skill => <li>{skill}</li>)}</ul></div></article>)}</div>
    </section>
    <section class="content-section" id="education" aria-labelledby="education-title">
      <div class="section-title"><h2 id="education-title">Education</h2></div>
      <div class="education-grid">{education.map(item => <article class="education-card"><div class="education-top"><span class="eyebrow">{item.level}</span><span>{item.dates}</span></div><h3>{item.degree}</h3><p class="organisation">{item.institution}</p><p class="qualification">{item.result}</p><p class="education-note">{item.note}</p></article>)}</div>
    </section>
    <section class="content-section" id="work" aria-labelledby="work-title">
      <div class="section-title"><h2 id="work-title">Selected research</h2><span>A closer look at the work</span></div>
      <div class="research-grid">{research.map(project => <article class="research-card"><p class="eyebrow">{project.category} · {project.period}</p><h3><a href={`${base}research/${project.slug}/`}>{project.title}</a></h3><p>{project.summary}</p><ul>{project.contribution.map(item => <li>{item}</li>)}</ul><a class="text-link" href={`${base}research/${project.slug}/`}>Read case study <span aria-hidden="true">↗</span></a></article>)}</div>
    </section>
    <section class="content-section" id="publications" aria-labelledby="publication-title"><div class="section-title"><h2 id="publication-title">Publication</h2></div><article class="publication"><span class="publication-year">2023<br /><span>Review article</span></span><div><h3><a href="https://doi.org/10.22034/IAR.2023.1995354.1505" target="_blank" rel="noopener noreferrer">The significant impacts of trace elements on marine life: a review <span aria-hidden="true">↗</span></a></h3><p>Bhattacharjee, S., Srivastava, A. and Das, S.P.<br /><cite>International Aquatic Research</cite></p><p class="contribution">My contribution: conceptualisation, data curation, figure and table preparation, and drafting.</p><a class="doi" href="https://doi.org/10.22034/IAR.2023.1995354.1505" target="_blank" rel="noopener noreferrer">DOI: 10.22034/IAR.2023.1995354.1505</a></div></article></section>
    <section class="content-section" id="skills" aria-labelledby="skills-title"><div class="section-title"><h2 id="skills-title">Skills</h2></div><div class="skills-grid">{skillGroups.map(group => <div><h3>{group.title}</h3><p>{group.items.join(' · ')}</p></div>)}</div></section>
    <section class="content-section about" id="about" aria-labelledby="about-title"><div class="section-title"><h2 id="about-title">About me</h2></div><div class="about-copy"><p>My research has taken me from shoreline surveys and spatial analysis to sequencing workflows and the biology of immune ageing. At Aberdeen, I explored age-associated patterns across T-cell subsets and built automated workflows to make the analysis easier to reproduce.</p><p>Across these experiences, I’ve developed an appreciation for organised information, careful quality control and well-explained results. I bring the same approach to literature reviews, data organisation, reporting and day-to-day tasks: understand what is needed, keep a clear record and follow the work through.</p></div></section>
    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div><p class="eyebrow">CONTACT</p><h2 id="contact-title">Let’s get in touch.</h2><p>To discuss a role, research opportunity or collaboration,<br class="desktop-break" /> you can reach me directly on LinkedIn.</p></div><a class="button" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Message on LinkedIn <span aria-hidden="true">↗</span></a></section>
  </div>
</Layout>
