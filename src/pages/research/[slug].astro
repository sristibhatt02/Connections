---
import Layout from '../../layouts/Layout.astro';
import { research } from '../../data/research';
import { profile } from '../../data/profile';
export function getStaticPaths(){ return research.map(project => ({params: {slug: project.slug}, props: {project}})); }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Layout title={`${project.title} — Sristi Bhattacharjee`} description={project.summary}>
  <article class="wrap case-study"><a class="text-link" href={`${base}#work`}>← Back to selected work</a><header class="case-header"><p class="eyebrow">{project.category} / ACADEMIC RESEARCH</p><h1>{project.title}<span class="accent">.</span></h1><p class="large-copy">{project.summary}</p><div class="case-meta"><span>{project.institution}</span><span>{project.period}</span></div></header><div class="case-content"><section><p class="eyebrow">01 / THE QUESTION</p><h2>{project.question}</h2></section><section><p class="eyebrow">02 / MY CONTRIBUTION</p><ul>{project.contribution.map(item=><li>{item}</li>)}</ul></section><section><p class="eyebrow">03 / DATA & METHODS</p><p>{project.methods}</p></section><section><p class="eyebrow">04 / OUTPUTS</p><p>{project.outputs}</p></section><section><p class="eyebrow">05 / SCOPE & LIMITATIONS</p><p>{project.limitations}</p></section><section><p class="eyebrow">06 / FURTHER INFORMATION</p><p>For a conversation about this work, <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">contact me on LinkedIn ↗</a>.</p></section></div><a class="text-link" href={`${base}#work`}>← Explore selected work</a></article>
</Layout>
